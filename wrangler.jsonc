// Cloudflare Workers with static assets. The site is fully static (`nuxt generate`),
// so there is no Worker script: Cloudflare serves `.output/public` directly.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./.output/public",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  // Custom domains: Cloudflare creates the DNS records and certificates on deploy.
  // The zone must already be on this account (it is: micheldpcarlos.com).
  "routes": [
    { "pattern": "micheldpcarlos.com", "custom_domain": true },
    { "pattern": "www.micheldpcarlos.com", "custom_domain": true }
  ],
  "preview_urls": true,
  "workers_dev": true
}
